# ─── База данных ──────────────────────────────────────────────
# SQLite-файл (путь относительно папки prisma/)
DATABASE_URL="file:../data/domkontrol.db"

# ─── Демо-режим ───────────────────────────────────────────────
# true  — доступна страница /demo (эмулятор MAX), уведомления демо-пользователю
#         пишутся в локальный чат.
# Если MAX_BOT_TOKEN пуст, демо-режим включается автоматически.
DEMO_MODE=true

# ─── MAX Bot API ──────────────────────────────────────────────
# Токен бота из настроек платформы MAX для партнёров.
# Пусто → используется MockMaxAdapter, всё работает локально.
MAX_BOT_TOKEN=
# Базовый URL Bot API (по официальной документации dev.max.ru)
MAX_API_URL=https://platform-api2.max.ru
# Секрет вебхука: MAX присылает его в заголовке X-Max-Bot-Api-Secret
MAX_WEBHOOK_SECRET=
# Публичный HTTPS-адрес приложения (для регистрации вебхука: npm run max:webhook)
PUBLIC_URL=

# ─── Панель УК ────────────────────────────────────────────────
# Если задан — /admin защищён HTTP Basic Auth (логин: admin)
ADMIN_PASSWORD=
