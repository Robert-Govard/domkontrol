{
  "name": "domkontrol",
  "version": "0.1.0",
  "private": true,
  "description": "ДомКонтроль — заявки жителей в управляющую компанию через MAX",
  "scripts": {
    "setup": "npm install && npm run db:reset",
    "dev": "cross-env NODE_EXTRA_CA_CERTS=./certs/russian_trusted_root_ca.pem next dev",
    "build": "prisma generate && next build",
    "start": "cross-env NODE_EXTRA_CA_CERTS=./certs/russian_trusted_root_ca.pem next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset": "prisma db push --force-reset && prisma db seed",
    "db:studio": "prisma studio",
    "max:webhook": "cross-env NODE_EXTRA_CA_CERTS=./certs/russian_trusted_root_ca.pem tsx scripts/max-webhook.ts",
    "max:polling": "cross-env NODE_EXTRA_CA_CERTS=./certs/russian_trusted_root_ca.pem tsx scripts/max-polling.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "geist": "^1.7.2",
    "lucide-react": "^1.48.0",
    "next": "15.5.26",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.7",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true,
    "unrs-resolver": true,
    "fsevents": false
  }
}
